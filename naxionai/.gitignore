node_modules/
dist/
.vault/
# The knowledge vault is its own git repo (see server/vault/.git), synced
# independently via VAULT_REPO — not versioned as part of this repo.
server/vault/
*.log
# Secrets + machine state — ALWAYS ignored, even in a private repo.
# .env carries live API keys; .naxion/ holds the encryption key and
# encrypted connection strings. Git history is forever.
.env
.env.local

# Vite
web/dist/
.DS_Store

# Naxie runtime state (custom templates, future caches) — per-machine
.naxion/

# User-fetched skill .md files (skill.fetch_remote drops them here, gated by
# NAXION_REMOTE_SKILLS=1). Per-machine, not shared.
server/src/skills/_user/

# Tunnel binary (downloaded per-machine) + operational logs
.tools/
_devlog.txt
_weblog.txt
_tunnel.log
# Test/scratch harness artifacts
server/_*-harness*
server/_*.out
server/eng.traineddata
server/page1.png

# Scratch / one-off outputs (root + server) — never version these
_*.out
_*.err
server/_*.json
server/_desk/

# Personal / private content — relaxed for private repo: tracked so it's
# backed up with the project. Crypto material + env backups stay ignored
# (they're credentials, not notes).
# personal/
# private/
# personal-uploads/
# my-notes/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.jks

# env backups (may contain secrets)
.env.bak*
.env.*.bak
.env

# runtime state (TTS cache, generated media, voice samples, daemon data)
.neuroworks/
