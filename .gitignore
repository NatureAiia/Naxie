# ==========================
# Secrets / environment — ALWAYS ignored, even in a private repo.
# Git history is forever and repo access spreads; a leaked .env with live
# API keys can't be un-pushed. Keep backing these up outside git
# (password manager / secrets vault), not in commits.
# ==========================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
skills-lock.json

# ==========================
# Node / TypeScript
# ==========================
node_modules/
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ==========================
# Python
# ==========================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================
# Docker / logs
# ==========================
*.log
logs/

# ==========================
# Local app data / vault
# ==========================
neuroworks-ts/.neuroworks/
neuroworks-ts/vault/*
!neuroworks-ts/vault/README.md
.neuroworks/
neuroworks/.neuroworks/
neuroworks/vault/*
!neuroworks/vault/README.md
neuroworks/server/vault/*
!neuroworks/server/vault/README.md

# ==========================
# IDE / OS — relaxed for private repo: editor settings are tracked so every
# clone gets the same workspace setup. Uncomment to ignore again.
# ==========================
# .vscode/
# .idea/
.DS_Store
Thumbs.db

# ==========================
# Claude Code local state
# ==========================
.claude/settings.local.json
