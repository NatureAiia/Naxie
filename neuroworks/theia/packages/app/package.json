{
  "name": "@naxion/theia-app",
  "productName": "Naxion IDE",
  "version": "0.1.0",
  "private": true,
  "description": "Naxion Theia application — focused workbench with AI agent integration",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Naxion IDE",
        "defaultTheme": {
          "light": "light",
          "dark": "dark"
        },
        "defaultIconTheme": "theia-file-icons"
      }
    },
    "backend": {
      "config": {}
    },
    "extensionDependencies": [
      "@naxion/agent-views"
    ]
  },
  "dependencies": {
    "@naxion/agent-views": "workspace:*",
    "@parcel/watcher": "^2.6.0",
    "@parcel/watcher-win32-x64": "^2.6.0",
    "@theia/ai-chat": "1.75.0",
    "@theia/ai-core": "1.75.0",
    "@theia/bulk-edit": "1.75.0",
    "@theia/bundle-plugin": "^1.75.0",
    "@theia/callhierarchy": "1.75.0",
    "@theia/core": "1.75.0",
    "@theia/debug": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/editor-preview": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/keymaps": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/monaco-editor-core": "^1.108.201",
    "@theia/output": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/scm": "1.75.0",
    "@theia/search-in-workspace": "1.75.0",
    "@theia/task": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/toolbar": "1.75.0",
    "@theia/typehierarchy": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@vscode/ripgrep-win32-x64": "^1.18.0",
    "drivelist": "^12.0.2",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "resolve-package-path": "^4.0.3",
    "typescript": "~5.6.3",
    "yargs": "^18.1.0"
  },
  "scripts": {
    "build": "theia build",
    "watch": "theia build --watch",
    "start": "theia start --port 7472",
    "dev": "theia dev --port 7472",
    "clean": "rimraf lib dist"
  },
  "license": "SEE LICENSE IN LICENSE"
}
