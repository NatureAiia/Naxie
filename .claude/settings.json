{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/graphify-hook.cmd search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/graphify-hook.cmd read"
          }
        ]
      }
    ]
  }
}
